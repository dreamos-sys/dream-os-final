  };
  if(localStorage.getItem('dreamos_tv_mode')==='true') document.body.classList.add('tv-mode');

  // 🔗 Share Handler (Mobile/Desktop Fallback)
  window.dreamShare = function(title, text){
    var url = window.location.href;
    if(navigator.share){
      navigator.share({title:title, text:text, url:url}).catch(function(){});
    } else if(navigator.clipboard){
      navigator.clipboard.writeText(url).then(function(){ alert('🔗 Link disalin ke clipboard. Buka di device/TV lain.'); });
    } else {
      prompt('Salin link manual:', url);
    }
  };

  // 🔍 Unified Search Engine (Client-Side)
  window.dreamSearch = function(query){
    if(!query || query.trim().length < 2) return [];
    var q = query.toLowerCase();
    var keys = ['dreamos_assets','dreamos_stok','dreamos_bookings','dreamos_dana','dreamos_maintenance_tasks','dreamos_k3_reports','dreamos_handover_log','dreamos_profile_audit'];
    var results = [];
    keys.forEach(function(k){
      try {
        var data = JSON.parse(localStorage.getItem(k)||'[]');
        if(!Array.isArray(data)) return;
        data.forEach(function(item, idx){
          var str = JSON.stringify(item).toLowerCase();
          if(str.includes(q)){
            var label = k.replace('dreamos_','').replace(/_/g,' ').toUpperCase();
            results.push({key:k, label:label, item:item, idx:idx});
          }
        });
      } catch(e){}
    });
    return results.slice(0, 20); // Max 20 hasil biar ringan
  };
  console.log('✅ Print/Share/Search core ready');
})();
</script>


