        :root {
            /* Light Mode Variables (Default fallback) */
            --bg-primary: #f1f5f9;
            --bg-void: #ffffff;
            --panel-bg: #ffffff;
            --text-primary: #0f172a;
            --text-main: #334155;
            --text-dim: #94a3b8;
            --neon-core: #059669;      /* Emerald Sultan */
            --neon-accent: #0284c7;    /* Cyber Blue Sultan */
            --neon-warning: #e11d48;
            --neon-amber: #d97706;
            --glass-border: rgba(0, 0, 0, 0.05);
            --shadow-glow: rgba(0, 0, 0, 0.05);
            --iso-9001: #059669;
            --iso-27001-b: #0284c7;
            --iso-27001-r: #e11d48;
            --iso-55001: #d97706;
            --arabic-color: #0f172a;
            --arabic-shadow: rgba(0, 0, 0, 0.1);
        }

        [data-theme="dark"] {
            --bg-primary: #0f172a;
            --bg-void: #020617;
            --panel-bg: #1e293b;
            --text-primary: #f8fafc;
            --text-main: #e2e8f0;
            --text-dim: #94a3b8;
            --neon-core: #34d399;
            --neon-accent: #0ea5e9;
            --neon-warning: #e11d48;
            --neon-amber: #f59e0b;
            --glass-border: rgba(255, 255, 255, 0.05);
            --shadow-glow: rgba(0, 255, 157, 0.15);
            --iso-9001: #10b981;
            --iso-27001-b: #0ea5e9;
            --iso-27001-r: #e11d48;
            --iso-55001: #f59e0b;
            --arabic-color: #00ff9d;
            --arabic-shadow: rgba(0, 255, 157, 0.3);
        }

        body { 
            margin: 0; padding: 0; overflow-x: hidden; 
            background: var(--bg-void); 
            color: var(--text-main);
            font-family: 'Inter', sans-serif; 
            min-height: 100vh;
            transition: background 0.4s ease, color 0.4s ease;
        }

        /* Login Screen */
        #login-screen { 
            position: fixed; inset: 0; display: flex; flex-direction: column; 
            align-items: center; justify-content: center; 
            background: var(--bg-void);
            z-index: 10000; transition: opacity 0.5s ease;
        }
        
        .stealth-gate { position: relative; margin-top: 2rem; display: flex; flex-direction: column; align-items: center; min-height: 80px; }
        .eye-btn { background: none; border: none; font-size: 1.8rem; cursor: pointer; color: var(--text-dim); transition: all 0.3s ease; }
        .eye-btn:active { color: var(--neon-core); text-shadow: 0 0 15px var(--neon-core); transform: scale(0.9); }

        .hidden-input-area { display: none; margin-top: 1rem; animation: fadeIn 0.4s ease; position: relative; }
        .hidden-input-area input {
            background: var(--panel-bg); border: 1px solid var(--neon-core);
            color: var(--neon-core); font-family: 'Orbitron', monospace; letter-spacing: 4px;
            text-align: center; padding: 0.75rem 1rem; border-radius: 8px; outline: none; width: 180px;
            box-shadow: inset 0 0 10px var(--shadow-glow);
        }
        .lockout-msg { color: var(--neon-warning); font-size: 0.8rem; margin-top: 10px; display: none; font-weight: 600; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }

        #main-app { display: none; }
        #dashboard-container { position: relative; z-index: 1; }

        /* Header */
        .header-main {
            padding: 2rem 1.5rem 1rem; text-align: center;
            border-bottom: 1px solid var(--glass-border); margin-bottom: 0.5rem;
            background: var(--bg-primary); transition: background 0.4s ease;
        }
        .header-main .logo-img { width: 48px; height: 48px; border-radius: 12px; cursor: pointer; margin-bottom: 0.5rem; }
        .header-main .arabic {
            font-family: 'Amiri', serif; color: var(--arabic-color);
            text-shadow: 0 0 20px var(--arabic-shadow); font-size: 1.5rem; margin-bottom: 0.2rem;
            transition: color 0.4s ease, text-shadow 0.4s ease;
