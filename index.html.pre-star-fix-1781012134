        if (dict[key]) {
            if (el.children.length === 0) { el.textContent = dict[key]; } 
            else { 
                var textNode = Array.from(el.childNodes).find(node => node.nodeType === 3 && node.textContent.trim() !== '');
                if(textNode) textNode.textContent = ' ' + dict[key];
                else el.querySelector('span:last-child') ? el.querySelector('span:last-child').textContent = dict[key] : null; 
