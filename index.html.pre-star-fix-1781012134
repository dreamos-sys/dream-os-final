        .header-main .shalawat { font-family: 'Amiri', serif; color: var(--neon-accent); font-size: 0.8rem; opacity: 0.9; }
        .info-badges { display: flex; justify-content: center; gap: 0.75rem; margin-top: 1rem; flex-wrap: wrap; }
