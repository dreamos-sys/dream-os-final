    <script>
        // --- THEME INIT ---
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();

        // --- CORE VARIABLES ---
        let attempts = 0;
        let lockoutUntil = localStorage.getItem('dream_lockout') || 0;
        let taps = 0, tapTimer, slideInterval;
        window.slideIdx = 0;

        // --- STEALTH SECURITY SYSTEM ---
        function checkLockout() {
            if (Date.now() < lockoutUntil) {
                let remain = Math.ceil((lockoutUntil - Date.now()) / 60000);
                document.getElementById('lock-msg').innerText = `SYSTEM LOCKED. RETRY IN ${remain} MINS.`;
                document.getElementById('lock-msg').style.display = 'block';
                document.getElementById('stealth-input').style.display = 'none';
                return true;
            } else {
                document.getElementById('lock-msg').style.display = 'none';
                return false;
            }
        }

        window.toggleStealth = function() {
            if (checkLockout()) return;
            let inp = document.getElementById('stealth-input');
            let passField = document.getElementById('pass');
            if (inp.style.display === 'block') {
                authenticate();
            } else {
                inp.style.display = 'block';
                passField.focus();
                if (!document.getElementById('toggle-pass')) {
                    let toggleBtn = document.createElement('span');
                    toggleBtn.id = 'toggle-pass';
                    toggleBtn.innerHTML = '👁️';
                    toggleBtn.style.cssText = 'position:absolute; right:0.5rem; top:50%; transform:translateY(-50%); cursor:pointer; font-size:1.2rem; color:#00ff9d; z-index:2;';
                    toggleBtn.onclick = function(e) {
                        e.stopPropagation();
                        passField.type = passField.type === 'password' ? 'text' : 'password';
                        toggleBtn.innerHTML = passField.type === 'password' ? '👁️' : '🙈';
                    };
                    inp.style.position = 'relative';
                    inp.appendChild(toggleBtn);
                }
            }
        };

        window.handleEnter = function(e) {
            if(e.key === 'Enter') authenticate();
        }
        function bindAuthKeys(){
            var pinField = document.getElementById('pass');
