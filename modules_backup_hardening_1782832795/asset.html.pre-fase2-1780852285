<button onclick="window.parent.goHome()" style="position:fixed;top:1rem;left:1rem;background:#1e293b;border:1px solid #2dd4bf;color:#2dd4bf;padding:0.5rem 1rem;border-radius:0.5rem;cursor:pointer;z-index:1000;">← Kembali</button>

<div style="min-height:100vh; background:#040814; color:#e2e8f0; font-family:'Inter',sans-serif; padding:1rem; padding-top:3.5rem; padding-bottom:5rem;" id="asset-app">
    <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1rem;">
        <h2 style="color:#06b6d4; font-size:1.4rem; font-weight:800; margin:0;">🏢 Asset & Gudang</h2>
    </div>

    <!-- Print Buttons -->
    <div style="display:flex; gap:0.5rem; margin-bottom:1rem; flex-wrap:wrap;">
        <button onclick="cetakPenyusutan()" style="padding:0.5rem 0.8rem; background:#10b981; color:white; border:none; border-radius:0.5rem; cursor:pointer; font-size:0.75rem;">📄 Penyusutan</button>
        <button onclick="cetakRAB()" style="padding:0.5rem 0.8rem; background:#f59e0b; color:#000; border:none; border-radius:0.5rem; cursor:pointer; font-size:0.75rem;">💰 RAB</button>
        <button onclick="cetakKartuStok()" style="padding:0.5rem 0.8rem; background:#6366f1; color:white; border:none; border-radius:0.5rem; cursor:pointer; font-size:0.75rem;">📋 Kartu Stok</button>
        <button onclick="cetakAssetList()" style="padding:0.5rem 0.8rem; background:#06b6d4; color:white; border:none; border-radius:0.5rem; cursor:pointer; font-size:0.75rem;">🏢 Daftar Aset</button>
    </div>

    <!-- Main Tabs -->
    <div style="display:flex; gap:0.5rem; margin-bottom:1rem; overflow-x:auto; padding-bottom:0.3rem;">
        <button class="ast-tab active" onclick="switchTab('asset')">🏢 Asset</button>
        <button class="ast-tab" onclick="switchTab('gudang')">📦 Gudang</button>
        <button class="ast-tab" onclick="switchTab('kartustok')">📋 Kartu Stok</button>
        <button class="ast-tab" onclick="switchTab('laporan')">📊 Laporan</button>
    </div>

    <!-- Tab Containers -->
    <div id="content-asset" class="ast-content"></div>
    <div id="content-gudang" class="ast-content" style="display:none;"></div>
    <div id="content-kartustok" class="ast-content" style="display:none;"></div>
    <div id="content-laporan" class="ast-content" style="display:none;"></div>
</div>

<style>
    .ast-tab { padding:0.5rem 1rem; border:none; border-radius:0.5rem; cursor:pointer; font-weight:600; font-size:0.8rem; white-space:nowrap; background:#1e293b; color:#e2e8f0; transition:0.3s; }
    .ast-tab.active { background:#06b6d4; color:#000; }
    .ast-panel { background:rgba(15,23,42,0.6); border:1px solid rgba(255,255,255,0.1); border-radius:0.75rem; padding:0.75rem; margin-bottom:0.75rem; }
</style>

<script>
(function(){
    function g(k){ try{return JSON.parse(localStorage.getItem(k)||'[]');}catch(e){return[];} }
    function s(k,d){ localStorage.setItem(k,JSON.stringify(d)); }
    function fmt(v){ return 'Rp '+(parseInt(v)||0).toLocaleString('id-ID'); }
    function dt(iso){ if(!iso)return '-'; var d=new Date(iso); return d.getDate()+'/'+(d.getMonth()+1)+' '+d.getHours()+':'+String(d.getMinutes()).padStart(2,'0'); }
    // Fallback admin check (single-PIN auth system)    function isAdmin(){ return true; }

    window.state = {
        tab: 'asset', assetTab: 'movable',
        showForm: false, showGudangForm: false,
        editData: { name:'', type:'movable', category:'Elektronik', location:'', value:'', condition:'Aktif' },
        gudangData: { nama:'', kategori:'janitor_indoor', jumlah:0, satuan:'pcs', minimal:5, lokasi:'', harga:0 },
        laporanBulan: new Date().getMonth(), laporanTahun: new Date().getFullYear()
    };

    window.switchTab = function(tab){
        state.tab = tab;
        document.querySelectorAll('.ast-tab').forEach(function(b){ b.classList.remove('active'); });
        event.target.classList.add('active');
        document.querySelectorAll('.ast-content').forEach(function(c){ c.style.display = 'none'; });
        document.getElementById('content-'+tab).style.display = 'block';
        if(tab==='asset') renderAsset();
        else if(tab==='gudang') renderGudang();
        else if(tab==='kartustok') renderKartuStok();
        else if(tab==='laporan') renderLaporan();
    };

    window.switchAssetTab = function(t){
        state.assetTab = t;
        renderAsset();
    };

    // ========== ASSET RENDER ==========
    window.renderAsset = function(){
        var assets = g('dreamos_assets');
        var filtered = assets.filter(function(a){
            if(state.assetTab==='fixed') return a.type==='fixed';
            if(state.assetTab==='intangible') return a.type==='intangible';
            return !a.type || a.type==='movable';
        });
        var totalVal = filtered.reduce(function(s,a){ return s+(parseInt(a.value||a.hargaBeli)||0); },0);
        
        var h = '<div style="display:flex;gap:0.5rem;margin-bottom:0.75rem;overflow-x:auto;">';
        ['movable','fixed','intangible'].forEach(function(t){
            var lbl = t==='movable'?'📦 Inventaris':t==='fixed'?'🏗️ Aset Tetap':'💡 Non-Materiil';
            var act = state.assetTab===t?'background:#00ff9d;color:#000;':'background:#1e293b;color:#e2e8f0;';
            h += '<button onclick="switchAssetTab(\''+t+'\')" style="padding:0.4rem 0.8rem;border:none;border-radius:0.5rem;cursor:pointer;font-weight:600;font-size:0.7rem;white-space:nowrap;'+act+'">'+lbl+'</button>';
        });
        h += '</div>';
        
        h += '<div class="ast-panel" style="text-align:center;"><div style="font-size:1.5rem;color:#00ff9d;font-weight:700;">'+fmt(totalVal)+'</div><div style="font-size:0.7rem;color:#94a3b8;">'+filtered.length+' aset</div></div>';
        
        if(isAdmin()){
            h += '<button onclick="state.showForm=!state.showForm;renderAsset();" style="width:100%;padding:0.5rem;margin-bottom:0.5rem;background:#06b6d4;color:white;border:none;border-radius:0.5rem;cursor:pointer;font-weight:600;">'+(state.showForm?'❌ Batal':'+ Tambah Aset')+'</button>';
            if(state.showForm){                h += '<div class="ast-panel"><input id="f-ast-name" placeholder="Nama Aset *" style="width:100%;margin-bottom:0.4rem;padding:0.5rem;background:#0f172a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;color:#e2e8f0;font-size:0.8rem;">';
                h += '<select id="f-ast-cat" style="width:100%;margin-bottom:0.4rem;padding:0.5rem;background:#0f172a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;color:#e2e8f0;font-size:0.8rem;"><option>Elektronik</option><option>Furniture</option><option>Mesin</option><option>Kendaraan</option><option>Peralatan</option><option>Tanah</option><option>Bangunan</option><option>Software</option></select>';
                h += '<input id="f-ast-loc" placeholder="Lokasi" style="width:100%;margin-bottom:0.4rem;padding:0.5rem;background:#0f172a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;color:#e2e8f0;font-size:0.8rem;">';
                h += '<input id="f-ast-val" type="number" placeholder="Nilai (Rp)" style="width:100%;margin-bottom:0.4rem;padding:0.5rem;background:#0f172a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;color:#e2e8f0;font-size:0.8rem;">';
                h += '<button onclick="saveAsset()" style="width:100%;padding:0.5rem;background:#10b981;color:white;border:none;border-radius:0.5rem;cursor:pointer;font-weight:600;">💾 Simpan Aset</button></div>';
            }
        }
        
        h += '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:0.5rem;">';
        filtered.forEach(function(a){
            var cc = a.condition==='Aktif'?'#10b981':a.condition==='Rusak Ringan'?'#f59e0b':'#ef4444';
            h += '<div class="ast-panel" style="text-align:center;padding:0.5rem;">';
            h += '<div style="font-size:1.5rem;margin-bottom:0.3rem;">'+(a.type==='fixed'?'🏗️':a.type==='intangible'?'💡':'📦')+'</div>';
            h += '<div style="font-weight:700;font-size:0.8rem;">'+(a.name||a.nama)+'</div>';
            h += '<div style="font-size:0.65rem;color:#94a3b8;">'+(a.category||'')+' | '+(a.location||'-')+'</div>';
            h += '<div style="color:#00ff9d;font-size:0.75rem;margin:0.3rem 0;">'+fmt(a.value||a.hargaBeli)+'</div>';
            h += '<span style="background:'+cc+';color:white;padding:0.1rem 0.4rem;border-radius:0.3rem;font-size:0.6rem;">'+(a.condition||'Aktif')+'</span>';
            h += '<div style="display:flex;gap:0.3rem;justify-content:center;margin-top:0.4rem;">';
            h += '<button onclick="generateQR(\''+a.id+'\',\''+(a.name||a.nama).replace(/'/g,"\\'")+'\')" style="background:#6366f1;color:white;border:none;border-radius:0.3rem;padding:0.1rem 0.4rem;font-size:0.6rem;cursor:pointer;">🔳</button>';
            if(isAdmin()) h += '<button onclick="deleteAsset(\''+a.id+'\')" style="background:#ef4444;color:white;border:none;border-radius:0.3rem;padding:0.1rem 0.4rem;font-size:0.6rem;cursor:pointer;">🗑️</button>';
            h += '</div></div>';
        });
        h += '</div>';
        document.getElementById('content-asset').innerHTML = h;
    };

    window.saveAsset = function(){
        var name = document.getElementById('f-ast-name').value.trim();
        if(!name) return alert('Nama aset wajib!');
        var assets = g('dreamos_assets');
        assets.push({
            id:'asset_'+Date.now(), name:name, type:state.assetTab,
            category:document.getElementById('f-ast-cat').value,
            location:document.getElementById('f-ast-loc').value.trim(),
            value:document.getElementById('f-ast-val').value,
            condition:'Aktif', date:new Date().toISOString()
        });
        s('dreamos_assets', assets);
        state.showForm = false;
        renderAsset();
    };

    window.deleteAsset = function(id){
        if(!confirm('Hapus aset ini?')) return;
        s('dreamos_assets', g('dreamos_assets').filter(function(a){return a.id!==id;}));
        renderAsset();
    };

    window.generateQR = function(id, name){
        var data = 'DREAMOS-ASSET:' + id;        var qrUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=' + encodeURIComponent(data);
        var win = window.open('', '_blank', 'width=400,height=500');
        var doc = '<html><head><title>QR - '+name+'</title><style>body{font-family:sans-serif;text-align:center;padding:20px;background:#0a0e27;color:white;}img{border:5px solid #00ff9d;border-radius:15px;}button{padding:10px 20px;background:#00ff9d;color:black;border:none;border-radius:10px;font-weight:bold;cursor:pointer;margin-top:10px;}@media print{button{display:none;}}</style></head><body>';
        doc += '<h2>'+name+'</h2><img src="'+qrUrl+'"><br><p style="color:#00ff9d;">DREAMOS-ASSET:'+id+'</p><button onclick="window.print()">🖨️ Cetak QR</button></body></html>';
        win.document.write(doc); win.document.close();
    };

    // ========== GUDANG RENDER ==========
    window.renderGudang = function(){
        var items = g('dreamos_stok');
        var totalVal = items.reduce(function(s,i){return s+((i.harga||0)*i.jumlah);},0);
        var lowCount = items.filter(function(i){return i.jumlah<=i.minimal;}).length;
        
        var h = '<div class="ast-panel" style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.5rem;text-align:center;">';
        h += '<div><div style="font-size:1.2rem;font-weight:700;color:#eab308;">'+items.length+'</div><div style="font-size:0.55rem;color:#94a3b8;">Jenis</div></div>';
        h += '<div><div style="font-size:1.2rem;font-weight:700;color:#00ff9d;">'+fmt(totalVal)+'</div><div style="font-size:0.55rem;color:#94a3b8;">Nilai</div></div>';
        h += '<div><div style="font-size:1.2rem;font-weight:700;color:'+(lowCount>0?'#ef4444':'#10b981')+';">'+lowCount+'</div><div style="font-size:0.55rem;color:#94a3b8;">Menipis</div></div></div>';
        
        if(isAdmin()){
            h += '<button onclick="state.showGudangForm=!state.showGudangForm;renderGudang();" style="width:100%;padding:0.5rem;margin-bottom:0.5rem;background:#eab308;color:#000;border:none;border-radius:0.5rem;cursor:pointer;font-weight:600;">'+(state.showGudangForm?'❌ Batal':'+ Tambah Stok')+'</button>';
            if(state.showGudangForm){
                h += '<div class="ast-panel"><input id="f-gd-nama" placeholder="Nama Barang *" style="width:100%;margin-bottom:0.3rem;padding:0.5rem;background:#0f172a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;color:#e2e8f0;font-size:0.8rem;">';
                h += '<select id="f-gd-kat" style="width:100%;margin-bottom:0.3rem;padding:0.5rem;background:#0f172a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;color:#e2e8f0;font-size:0.8rem;"><option value="janitor_indoor">Janitor Indoor</option><option value="janitor_outdoor">Janitor Outdoor</option><option value="maintenance">Maintenance</option><option value="kimia">Kimia</option><option value="pewangi">Pewangi</option><option value="atk">ATK</option><option value="lainnya">Lainnya</option></select>';
                h += '<input id="f-gd-jml" type="number" placeholder="Jumlah" style="width:100%;margin-bottom:0.3rem;padding:0.5rem;background:#0f172a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;color:#e2e8f0;font-size:0.8rem;">';
                h += '<input id="f-gd-hrg" type="number" placeholder="Harga Satuan (Rp)" style="width:100%;margin-bottom:0.3rem;padding:0.5rem;background:#0f172a;border:1px solid rgba(255,255,255,0.1);border-radius:0.5rem;color:#e2e8f0;font-size:0.8rem;">';
                h += '<button onclick="saveGudang()" style="width:100%;padding:0.5rem;background:#10b981;color:white;border:none;border-radius:0.5rem;cursor:pointer;font-weight:600;">💾 Simpan Stok</button></div>';
            }
        }
        
        h += '<div style="display:flex;flex-direction:column;gap:0.4rem;">';
        items.forEach(function(item){
            var low = item.jumlah <= item.minimal;
            h += '<div class="ast-panel" style="padding:0.6rem;border-left:4px solid '+(low?'#ef4444':'#10b981')+';">';
            h += '<div style="display:flex;justify-content:space-between;align-items:center;">';
            h += '<div><div style="font-weight:700;font-size:0.8rem;">'+item.nama+'</div><div style="font-size:0.6rem;color:#94a3b8;">'+item.kategori+' | '+fmt(item.harga)+'/'+(item.satuan||'pcs')+'</div></div>';
            h += '<div style="text-align:right;"><div style="font-weight:700;font-size:0.9rem;color:'+(low?'#ef4444':'#00ff9d')+';">'+item.jumlah+' '+(item.satuan||'pcs')+'</div><div style="font-size:0.55rem;color:#94a3b8;">Min: '+item.minimal+'</div>';
            h += '<div style="display:flex;gap:0.2rem;margin-top:0.3rem;justify-content:flex-end;">';
            h += '<button onclick="generateQRGudang(\''+item.id+'\',\''+item.nama.replace(/'/g,"\\'")+'\')" style="background:#6366f1;color:white;border:none;border-radius:0.3rem;padding:0.1rem 0.4rem;font-size:0.6rem;cursor:pointer;">🔳</button>';
            if(isAdmin()){
                h += '<button onclick="stokKeluar(\''+item.id+'\')" style="background:#ef4444;color:white;border:none;border-radius:0.3rem;padding:0.1rem 0.4rem;font-size:0.6rem;cursor:pointer;">- Keluar</button>';
                h += '<button onclick="deleteGudang(\''+item.id+'\')" style="background:#dc2626;color:white;border:none;border-radius:0.3rem;padding:0.1rem 0.4rem;font-size:0.6rem;cursor:pointer;">🗑</button>';
            }
            h += '</div></div></div></div>';
        });
        h += '</div>';
        document.getElementById('content-gudang').innerHTML = h;
    };

    window.saveGudang = function(){
        var nama = document.getElementById('f-gd-nama').value.trim();        var jml = parseInt(document.getElementById('f-gd-jml').value)||0;
        if(!nama || jml<=0) return alert('Nama dan jumlah wajib!');
        var items = g('dreamos_stok');
        var existing = items.find(function(x){return x.nama===nama && x.kategori===document.getElementById('f-gd-kat').value;});
        if(existing){
            existing.jumlah += jml;
            existing.harga = parseInt(document.getElementById('f-gd-hrg').value)||existing.harga;
        } else {
            items.push({id:'stok_'+Date.now(), nama:nama, kategori:document.getElementById('f-gd-kat').value, jumlah:jml, satuan:'pcs', minimal:5, lokasi:'', harga:parseInt(document.getElementById('f-gd-hrg').value)||0, created:new Date().toISOString()});
        }
        s('dreamos_stok', items);
        var ks = g('dreamos_kartu_stok');
        ks.push({id:'ks_'+Date.now(), nama:nama, kategori:document.getElementById('f-gd-kat').value, tipe:'MASUK', jumlah:jml, harga:parseInt(document.getElementById('f-gd-hrg').value)||0, petugas:'Admin', tanggal:new Date().toISOString()});
        s('dreamos_kartu_stok', ks.slice(-500));
        state.showGudangForm = false;
        renderGudang();
    };

    window.stokKeluar = function(id){
        var items = g('dreamos_stok');
        var item = items.find(function(i){return i.id===id;});
        if(!item) return;
        var qty = prompt('Jumlah keluar untuk '+item.nama+':', '1');
        if(!qty || parseInt(qty)<=0) return;
        qty = parseInt(qty);
        if(qty > item.jumlah) return alert('Stok tidak cukup!');
        item.jumlah -= qty;
        s('dreamos_stok', items);
        var ks = g('dreamos_kartu_stok');
        ks.push({id:'ks_'+Date.now(), nama:item.nama, kategori:item.kategori, tipe:'KELUAR', jumlah:qty, harga:item.harga||0, petugas:'Admin', tanggal:new Date().toISOString()});
        s('dreamos_kartu_stok', ks.slice(-500));
        renderGudang();
    };

    window.deleteGudang = function(id){
        if(!confirm('Hapus item gudang ini?')) return;
        s('dreamos_stok', g('dreamos_stok').filter(function(i){return i.id!==id;}));
        renderGudang();
    };

    window.generateQRGudang = function(id, name){
        var data = 'DREAMOS-GDG:' + id;
        var qrUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=' + encodeURIComponent(data);
        var win = window.open('', '_blank', 'width=400,height=500');
        var doc = '<html><head><title>QR - '+name+'</title><style>body{font-family:sans-serif;text-align:center;padding:20px;background:#0a0e27;color:white;}img{border:5px solid #f59e0b;border-radius:15px;}button{padding:10px 20px;background:#f59e0b;color:black;border:none;border-radius:10px;font-weight:bold;cursor:pointer;margin-top:10px;}@media print{button{display:none;}}</style></head><body>';
        doc += '<h2>'+name+'</h2><img src="'+qrUrl+'"><br><p style="color:#f59e0b;">DREAMOS-GDG:'+id+'</p><button onclick="window.print()">🖨️ Cetak QR</button></body></html>';
        win.document.write(doc); win.document.close();
    };

    // ========== KARTU STOK RENDER ==========    window.renderKartuStok = function(){
        var ks = g('dreamos_kartu_stok');
        var h = '<div class="ast-panel"><h4 style="color:#00ff9d;margin-bottom:0.5rem;">📋 Kartu Stok</h4>';
        if(!ks.length) h += '<div style="color:#94a3b8;">Belum ada transaksi</div>';
        else {
            h += '<div style="max-height:400px;overflow-y:auto;">';
            ks.slice(-30).reverse().forEach(function(k){
                h += '<div style="padding:0.4rem;margin-bottom:0.2rem;background:rgba(30,41,59,0.6);border-radius:0.3rem;font-size:0.75rem;display:flex;justify-content:space-between;">';
                h += '<div><span style="color:'+(k.tipe==='MASUK'?'#10b981':'#ef4444')+';font-weight:700;">'+k.tipe+' </span>'+k.nama+' x'+k.jumlah+'</div>';
                h += '<div style="font-size:0.65rem;color:#94a3b8;">'+dt(k.tanggal)+'</div></div>';
            });
            h += '</div>';
        }
        h += '</div>';
        document.getElementById('content-kartustok').innerHTML = h;
    };

    // ========== LAPORAN RENDER ==========
    window.renderLaporan = function(){
        var MONTHS = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
        var prefix = state.laporanTahun+'-'+String(state.laporanBulan+1).padStart(2,'0');
        var ks = g('dreamos_kartu_stok').filter(function(k){return k.tanggal && k.tanggal.startsWith(prefix);});
        var masuk = ks.filter(function(k){return k.tipe==='MASUK';});
        var keluar = ks.filter(function(k){return k.tipe==='KELUAR';});
        var totalMasuk = masuk.reduce(function(s,k){return s+k.jumlah;},0);
        var totalKeluar = keluar.reduce(function(s,k){return s+k.jumlah;},0);
        var nilaiMasuk = masuk.reduce(function(s,k){return s+(k.jumlah*k.harga);},0);
        var nilaiKeluar = keluar.reduce(function(s,k){return s+(k.jumlah*k.harga);},0);
        
        var h = '<div class="ast-panel" style="text-align:center;display:flex;justify-content:space-between;align-items:center;">';
        h += '<button onclick="state.laporanBulan--;if(state.laporanBulan<0){state.laporanBulan=11;state.laporanTahun--;}renderLaporan();" style="background:#1e293b;border:none;color:#e2e8f0;padding:0.5rem;border-radius:0.5rem;cursor:pointer;">◀</button>';
        h += '<span style="font-weight:700;">'+MONTHS[state.laporanBulan]+' '+state.laporanTahun+'</span>';
        h += '<button onclick="state.laporanBulan++;if(state.laporanBulan>11){state.laporanBulan=0;state.laporanTahun++;}renderLaporan();" style="background:#1e293b;border:none;color:#e2e8f0;padding:0.5rem;border-radius:0.5rem;cursor:pointer;">▶</button></div>';
        
        h += '<div class="ast-panel"><h4 style="color:#00ff9d;margin-bottom:0.5rem;">Ringkasan Bulan Ini</h4>';
        h += '<div style="font-size:0.8rem;line-height:1.6;">📥 Masuk: '+totalMasuk+' item | Nilai: '+fmt(nilaiMasuk)<br>📤 Keluar: '+totalKeluar+' item | Nilai: '+fmt(nilaiKeluar)<br>📋 Total Transaksi: '+ks.length+'</div></div>';
        document.getElementById('content-laporan').innerHTML = h;
    };

    // ========== PRINT FUNCTIONS (CLEAN & CONSOLIDATED) ==========
    window.cetakPenyusutan = function(){
        var assets = g('dreamos_assets').filter(function(a){return a.type==='fixed'||a.type==='movable'||!a.type;});
        if(!assets.length) return alert('Belum ada data aset!');
        var win = window.open('', '_blank', 'width=900,height=600');
        var doc = '<html><head><title>Laporan Penyusutan Aset</title><style>body{font-family:sans-serif;padding:20px;color:#111;}h2{text-align:center;}table{width:100%;border-collapse:collapse;margin-top:10px;}th,td{border:1px solid #000;padding:8px;text-align:left;}th{background:#eee;}.total{font-weight:bold;background:#e0f0e0;}@media print{button{display:none;}}</style></head><body>';
        doc += '<h2>LAPORAN PENYUSUTAN ASET</h2><p>Tanggal: '+new Date().toLocaleDateString('id-ID')+'</p><button onclick="window.print()" style="padding:10px 20px;background:#10b981;color:white;border:none;border-radius:5px;cursor:pointer;margin-bottom:10px;">🖨️ Cetak</button>';
        doc += '<table><tr><th>No</th><th>Nama Aset</th><th>Kategori</th><th>Lokasi</th><th>Nilai Perolehan</th><th>Penyusutan (10%)</th><th>Nilai Buku</th></tr>';
        var tP=0,tS=0,tB=0;
        assets.forEach(function(a,i){
            var n=parseInt(a.value||a.hargaBeli)||0, s=Math.round(n*0.1), b=n-s;            tP+=n;tS+=s;tB+=b;
            doc += '<tr><td>'+(i+1)+'</td><td>'+(a.name||a.nama)+'</td><td>'+a.category+'</td><td>'+a.location+'</td><td>'+fmt(n)+'</td><td>'+fmt(s)+'</td><td>'+fmt(b)+'</td></tr>';
        });
        doc += '<tr class="total"><td colspan="4">TOTAL</td><td>'+fmt(tP)+'</td><td>'+fmt(tS)+'</td><td>'+fmt(tB)+'</td></tr></table>';
        doc += '<p style="margin-top:30px;text-align:right;">Mengetahui,<br><br><br>Kepala Bagian Umum</p></body></html>';
        win.document.write(doc); win.document.close();
    };

    window.cetakRAB = function(){
        var items = g('dreamos_stok');
        if(!items.length) return alert('Belum ada data stok!');
        var win = window.open('', '_blank', 'width=900,height=600');
        var doc = '<html><head><title>RAB Pengadaan</title><style>body{font-family:sans-serif;padding:20px;color:#111;}h2{text-align:center;}table{width:100%;border-collapse:collapse;margin-top:10px;}th,td{border:1px solid #000;padding:8px;text-align:left;}th{background:#eee;}.total{font-weight:bold;background:#e0f0e0;}@media print{button{display:none;}}</style></head><body>';
        doc += '<h2>RENCANA ANGGARAN BIAYA (RAB)</h2><p>Tanggal: '+new Date().toLocaleDateString('id-ID')+'</p><button onclick="window.print()" style="padding:10px 20px;background:#f59e0b;color:black;border:none;border-radius:5px;cursor:pointer;margin-bottom:10px;">🖨️ Cetak</button>';
        doc += '<table><tr><th>No</th><th>Nama Barang</th><th>Kategori</th><th>Jumlah</th><th>Satuan</th><th>Harga Satuan</th><th>Total</th></tr>';
        var gT=0;
        items.forEach(function(it,i){
            var t=(it.harga||0)*it.jumlah; gT+=t;
            doc += '<tr><td>'+(i+1)+'</td><td>'+it.nama+'</td><td>'+it.kategori+'</td><td>'+it.jumlah+'</td><td>'+(it.satuan||'pcs')+'</td><td>'+fmt(it.harga)+'</td><td>'+fmt(t)+'</td></tr>';
        });
        doc += '<tr class="total"><td colspan="6">TOTAL</td><td>'+fmt(gT)+'</td></tr></table>';
        doc += '<p style="margin-top:30px;text-align:right;">Mengetahui,<br><br><br>Kepala Bagian Umum</p></body></html>';
        win.document.write(doc); win.document.close();
    };

    window.cetakKartuStok = function(){
        var ks = g('dreamos_kartu_stok');
        if(!ks.length) return alert('Belum ada transaksi!');
        var win = window.open('', '_blank', 'width=900,height=600');
        var doc = '<html><head><title>Kartu Stok</title><style>body{font-family:sans-serif;padding:20px;color:#111;}h2{text-align:center;}table{width:100%;border-collapse:collapse;margin-top:10px;}th,td{border:1px solid #000;padding:8px;text-align:left;}th{background:#eee;}.masuk{color:green;}.keluar{color:red;}@media print{button{display:none;}}</style></head><body>';
        doc += '<h2>KARTU STOK</h2><p>Tanggal: '+new Date().toLocaleDateString('id-ID')+'</p><button onclick="window.print()" style="padding:10px 20px;background:#6366f1;color:white;border:none;border-radius:5px;cursor:pointer;margin-bottom:10px;">🖨️ Cetak</button>';
        doc += '<table><tr><th>No</th><th>Tanggal</th><th>Nama Barang</th><th>Tipe</th><th>Jumlah</th><th>Harga</th><th>Petugas</th></tr>';
        ks.slice(-100).reverse().forEach(function(k,i){
            doc += '<tr><td>'+(i+1)+'</td><td>'+dt(k.tanggal)+'</td><td>'+k.nama+'</td><td class="'+(k.tipe==='MASUK'?'masuk':'keluar')+'">'+k.tipe+'</td><td>'+k.jumlah+'</td><td>'+fmt(k.harga)+'</td><td>'+k.petugas+'</td></tr>';
        });
        doc += '</table></body></html>';
        win.document.write(doc); win.document.close();
    };

    window.cetakAssetList = function(){
        var assets = g('dreamos_assets');
        if(!assets.length) return alert('Belum ada data aset!');
        var win = window.open('', '_blank', 'width=900,height=600');
        var doc = '<html><head><title>Daftar Aset</title><style>body{font-family:sans-serif;padding:20px;color:#111;}h2{text-align:center;}table{width:100%;border-collapse:collapse;margin-top:10px;}th,td{border:1px solid #000;padding:8px;text-align:left;}th{background:#eee;}@media print{button{display:none;}}</style></head><body>';
        doc += '<h2>DAFTAR ASET</h2><p>Tanggal: '+new Date().toLocaleDateString('id-ID')+'</p><button onclick="window.print()" style="padding:10px 20px;background:#06b6d4;color:white;border:none;border-radius:5px;cursor:pointer;margin-bottom:10px;">🖨️ Cetak</button>';
        doc += '<table><tr><th>No</th><th>Nama Aset</th><th>Kategori</th><th>Lokasi</th><th>Nilai</th><th>Kondisi</th></tr>';
        var t=0;
        assets.forEach(function(a,i){
            var n=parseInt(a.value||a.hargaBeli)||0; t+=n;
            doc += '<tr><td>'+(i+1)+'</td><td>'+(a.name||a.nama)+'</td><td>'+a.category+'</td><td>'+a.location+'</td><td>'+fmt(n)+'</td><td>'+(a.condition||'Aktif')+'</td></tr>';        });
        doc += '<tr style="font-weight:bold;background:#e0f0e0;"><td colspan="4">TOTAL</td><td>'+fmt(t)+'</td><td></td></tr></table></body></html>';
        win.document.write(doc); win.document.close();
    };

    // INIT
    try { renderAsset(); } catch(e) { console.error('❌ Asset Init Error:', e); }
})();
</script>
